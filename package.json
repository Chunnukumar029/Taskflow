{
  "name": "taskflow",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev -- --host 0.0.0.0\"",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
